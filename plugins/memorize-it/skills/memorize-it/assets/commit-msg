#!/bin/sh
# memorize-it commit-msg hook — enforces the commit standard on LOCAL commits.
#
# Generated by the memorize-it skill's Setup. Enforcement only: it validates the
# message and rejects the commit if the standard isn't met. It does not scaffold
# or modify messages.
#
# NOTE: this runs only for commits made in this clone. Squash-merges performed in
# a host's web UI (e.g. GitHub) compose the message server-side, where this hook
# does not run — so it cannot guarantee the message that lands on the trunk.
#
# Edit the CONFIG block if your convention changes; keep it in sync with
# .claude/rules/memorize-it.md.

# --- CONFIG (Setup fills these from your confirmed choices) ---------------
# Subject pattern. Default = bracket issue key, e.g. "[WEB-123] Summary".
#   Conventional-commits alternative:
#   SUBJECT_REGEX='^(feat|fix|chore|docs|refactor|test|build|ci|perf|style)(\(.+\))?!?: .+'
SUBJECT_REGEX='^\[[A-Za-z]*-?[0-9]+\] .+'
# Required body field labels (space-separated), matched case-insensitively as "^label:".
REQUIRED_FIELDS='why what'
# --------------------------------------------------------------------------

msg_file="$1"
msg=$(cat "$msg_file")
head1=$(printf '%s\n' "$msg" | sed -n '1p')

# Let machine-generated commits through untouched.
case "$head1" in
  Merge\ *|Revert\ *|Reapply\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

status=0
say() { echo "memorize-it: $1" >&2; status=1; }

printf '%s\n' "$head1" | grep -Eq "$SUBJECT_REGEX" \
  || say "subject must match the project convention: $SUBJECT_REGEX"

for field in $REQUIRED_FIELDS; do
  printf '%s\n' "$msg" | grep -iq "^$field:" \
    || say "commit body is missing a '$field:' line"
done

if [ "$status" -ne 0 ]; then
  echo "memorize-it: see .claude/rules/memorize-it.md for the commit standard." >&2
fi
exit $status
